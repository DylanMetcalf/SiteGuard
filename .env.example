# Copy to .env and adjust. Everything except DATABASE_URL has a working default for local dev.

NODE_ENV=development
PORT=3000
# Public URL of the app — used in emails and share links.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://siteguard:siteguard@localhost:5432/siteguard
# DATABASE_SSL=true            # most managed Postgres providers need this
# TRUST_PROXY=true             # REQUIRED behind a load balancer, or rate limits see every user as one IP

# --- File storage -------------------------------------------------------------
# "local" writes to LOCAL_STORAGE_DIR (dev only). Use "s3" for AWS S3, Cloudflare R2 or MinIO.
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_BUCKET=siteguard-documents
# S3_REGION=af-south-1          # R2: auto
# S3_ENDPOINT=http://localhost:9000   # MinIO / R2 endpoint; omit for AWS
# S3_FORCE_PATH_STYLE=true      # MinIO
# S3_SSE=aws:kms                # optional; AWS/R2 already encrypt at rest by default
# S3_ACCESS_KEY_ID=siteguard
# S3_SECRET_ACCESS_KEY=siteguard-secret
# MAX_UPLOAD_MB=20

# --- Email --------------------------------------------------------------------
# Unset → emails are printed to the server log (and kept in the email_outbox table).
# SMTP_URL=smtp://localhost:1025                 # Mailpit from docker-compose
# SMTP_URL=smtps://USER:PASS@smtp.postmarkapp.com:465
EMAIL_FROM=SiteGuard <no-reply@siteguard.local>

# --- AI drafting (server-side proxy; the key never reaches browsers) -------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# AI_MONTHLY_REQUEST_LIMIT=300

# --- Billing (Stripe) -----------------------------------------------------------
# Unset → billing is off and every organisation has full access.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Per-seat recurring prices:
# STRIPE_PRICE_HOST_STARTER=price_...
# STRIPE_PRICE_HOST_PRO=price_...
# STRIPE_PRICE_CONTRACTOR_PRO=price_...

# --- Demo & QA ------------------------------------------------------------------
DEMO_SANDBOX_ENABLED=true
# Lets any session switch into demo personas. Refused when NODE_ENV=production.
DEV_ROLE_SWITCHER=false
# Run email delivery + reminder jobs in the web process (set false and run `npm run worker:prod` separately at scale).
RUN_JOBS_IN_WEB=true
