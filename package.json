{
  "name": "comvera",
  "version": "0.1.0",
  "private": true,
  "description": "COMVERA \u2014 multi-tenant contractor compliance and site safety platform",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "worker": "tsx src/jobs/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "worker:prod": "node dist/jobs/worker.js",
    "test:e2e": "node test/e2e/two-party.e2e.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:bots": "tsx scripts/bots.mts",
    "test:bots:security": "tsx scripts/bots2.mts",
    "test:bots:ux": "tsx scripts/bots-ux.mts",
    "test:bots:shared-address": "tsx scripts/bots-nat.mts",
    "seed": "tsx scripts/seed-test-data.mts",
    "restore-drill": "tsx scripts/restore-drill.mts",
    "test:journey": "tsx scripts/contractor-journey.mts",
    "test:landing": "tsx scripts/landing-audit.mts",
    "test:today": "tsx scripts/today-check.mts",
    "test:consultant": "tsx scripts/consultant-check.mts",
    "test:requests": "tsx scripts/docrequests-journey.mts",
    "activation": "tsx scripts/activation-report.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@types/qrcode": "^1.5.6",
    "docx": "^9.15.0",
    "fastify": "^5.12.7",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.13",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "^14.0.2"
  }
}
